<Project>

	<PropertyGroup>
		<IsMac>$([MSBuild]::IsOSPlatform('OSX'))</IsMac>
		<IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</IsWindows>
		<IsLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsLinux>
	</PropertyGroup>

	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<ReleaseVersion>2.5.3.0</ReleaseVersion>
		<RepositoryUrl>https://github.com/mono/taglib-sharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<ExeTargetFrameworks>net9.0;net10.0;net11.0</ExeTargetFrameworks>
		<LibTargetFrameworks>net9.0;net10.0;net11.0</LibTargetFrameworks>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>true</ImplicitUsings>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<LangVersion>latest</LangVersion>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

</Project>
